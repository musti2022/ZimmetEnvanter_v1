# ============================================================================
#  Zimmet & Envanter — ortam yapılandırması
#  Bu dosyayı ".env" olarak kopyalayın ve değerleri doldurun.
#  .env ASLA sürüm kontrolüne girmez (.gitignore'da listelidir).
#
#  Üretimde secret manager kullanımı: dotenv yalnızca ortamda TANIMSIZ anahtarları
#  doldurur. Değerleri süreç ortamına enjekte ederseniz .env dosyasına gerek kalmaz.
# ============================================================================

# ---------------------------------------------------------------------------
# Ortam
# ---------------------------------------------------------------------------
# production: Secure çerez + HSTS + SESSION_SECRET zorunluluğu devreye girer.
NODE_ENV=production

# ---------------------------------------------------------------------------
# Veritabanı (SQL Server — Windows kimlik doğrulama / ODBC)
# ---------------------------------------------------------------------------
# Sunucu adı SSMS'teki "Data Source" değeriyle aynıdır:
#   varsayılan örnek → ZE_SQL_SERVER=SUNUCUADI
#   adlandırılmış    → ZE_SQL_SERVER=SUNUCUADI\SQLEXPRESS
ZE_SQL_SERVER=(local)\SQLEXPRESS
ZE_SQL_DB=ZimmetEnvanter
ZE_ODBC_DRIVER=ODBC Driver 17 for SQL Server
ZE_PORT=5176

# Şifreleme. Boş bırakılırsa ODBC sürücüsünün varsayılanı geçerlidir
# (Driver 17: şifresiz, Driver 18: şifreli + sertifika doğrulamalı).
# SSMS bağlantı dizenizde Encrypt=True varsa buraya da yes yazın.
ZE_SQL_ENCRYPT=

# ⚠ yes yapmak sunucu sertifikasının DOĞRULANMASINI KAPATIR. SQL Server kendinden
# imzalı sertifika kullanıyorsa (SSMS'te TrustServerCertificate=True görüyorsanız)
# bağlanmanın pratik yolu budur; araya giren saldırgana karşı koruma kalkar.
# Yalnızca güvenilen iç ağda kullanın.
ZE_SQL_TRUST_CERT=

# ---------------------------------------------------------------------------
# Oturum güvenliği
# ---------------------------------------------------------------------------
# ZORUNLU (üretimde). En az 32 karakter. Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

SESSION_COOKIE_NAME=ze.sid
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=8

# HTTPS zorunluluğu. Üretimde 1 olmalı (NODE_ENV=production ise varsayılan zaten 1).
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_SAMESITE=lax

# Ters vekil (nginx / IIS ARR) arkasındaysanız 1 yapın — doğru istemci IP'si için gerekli.
# Vekil YOKSA 1 YAPMAYIN: X-Forwarded-For sahtelenerek hız sınırı atlatılabilir.
TRUST_PROXY=0

# ---------------------------------------------------------------------------
# Parola politikası (yalnızca YEREL hesaplar; AD parolaları AD politikasına tabidir)
# ---------------------------------------------------------------------------
PASSWORD_MIN_LENGTH=12
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1

# ---------------------------------------------------------------------------
# Giriş hız sınırlama (kaba kuvvet / kimlik bilgisi doldurma)
# ---------------------------------------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_MINUTES=10
# IP sayacı sınırı = LOGIN_MAX_ATTEMPTS × LOGIN_IP_MULTIPLIER
LOGIN_IP_MULTIPLIER=4

# ---------------------------------------------------------------------------
# Denetim günlüğü
# ---------------------------------------------------------------------------
AUDIT_RETENTION_DAYS=365
