{
  "name": "zimmet-envanter",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Zimmet ve Envanter Takip - birleşik uygulama",
  "scripts": {
    "dev": "concurrently -k -n api,vite,dist \"node server/index.js 5177\" \"vite\" \"vite build --watch --logLevel warn\"",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "vite preview --port 4175",
    "test": "node --test \"server/tests/**/*.test.js\"",
    "kullanici": "node server/scripts/kullanici.js",
    "anahtar-uret": "node -e \"console.log(require('crypto').randomBytes(48).toString('base64url'))\""
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@node-rs/argon2": "^2.1.0",
    "@zxing/library": "^0.23.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "msnodesqlv8": "^5.2.1",
    "mssql": "^12.7.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "selfsigned": "^5.5.0",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.3",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "msnodesqlv8@5.2.1": true,
    "esbuild@0.21.5": true
  }
}
